# Frontend
VITE_API_BASE_URL=http://localhost:4000/api

# Backend
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
TRUST_PROXY=1

# PostgreSQL (Managed PostgreSQL / Supabase or local native PostgreSQL)
# Runtime URL: least-privilege `app_runtime` role (never schema owner `postgres`).
# On Supabase, for IPv4 networks use Supavisor Session Pooler port 5432 (or direct IPv6 port 5432),
# or Transaction Pooler port 6543 with ?pgbouncer=true for runtime Prisma queries only.
DATABASE_URL=postgresql://app_runtime:CHANGE_ME@localhost:5432/balancevault
# Migration / Operator URL: schema-owner role (`postgres` on Supabase or `app_migrator`),
# used ONLY for `prisma:migrate:deploy`, `db:inspect-roles`, SQL hardening, and `bootstrap:admin`.
# Must use direct/session port 5432 without ?pgbouncer=true.
DIRECT_URL=postgresql://app_migrator:CHANGE_ME@localhost:5432/balancevault

# Redis (Managed Redis or local native Redis)
REDIS_URL=redis://localhost:6379

# Session
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# One-time admin bootstrap: use only during controlled out-of-band bootstrap.
# Never commit real values. Remove/disable after successful bootstrap.
ADMIN_BOOTSTRAP_EMAIL=admin@example.test
ADMIN_BOOTSTRAP_NAME=BalanceVault Super Admin
ADMIN_BOOTSTRAP_SECRET=REPLACE_WITH_ONE_TIME_SECRET
ADMIN_BOOTSTRAP_PASSWORD=REPLACE_WITH_STRONG_ONE_TIME_PASSWORD

# Optional
LOG_LEVEL=info
